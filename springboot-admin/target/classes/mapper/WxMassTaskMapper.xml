<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.mapper.WxMassTaskMapper">

    <!-- 物理删除群发任务；userId 为空时不限制用户 -->
    <delete id="physicalDeleteById">
        DELETE FROM wx_mass_task
        WHERE id = #{id}
        <if test="userId != null">
            AND user_id = #{userId}
        </if>
    </delete>

</mapper>
